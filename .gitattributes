# Normalize line endings (cross-platform: Linux/macOS/Windows CI matrix)
* text=auto eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.lock text eol=lf

# Exclude dev-only files from `git archive` tarballs.
# NOTE: `cargo package` ignores export-ignore — its list lives in Cargo.toml `exclude`.
# Cargo.lock is KEPT — this is a binary crate, consumers build from source.
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/tests export-ignore
/scripts export-ignore
